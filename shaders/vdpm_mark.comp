#version 450
#extension GL_EXT_buffer_reference : require

// VDPM GPU refine/coarsen pass 1 (Stage B3): over ALL splits, FULL-OVERWRITE the per-split
// `required` seed = the refine predicate applyMarkRequired (ScoreOut struct + reduction + predicate
// live in the shared vdpm_apply_classify.glsl — one authority with score/coarsen/kernel). Full
// overwrite means no separate clear is needed before the closure.

#include "vdpm_apply_classify.glsl"

layout(buffer_reference, std430, buffer_reference_align = 4) buffer ScoreBuf
{
    ScoreOut v[];
};
layout(buffer_reference, std430, buffer_reference_align = 4) buffer UintBuf
{
    uint v[];
};

layout(push_constant) uniform Push
{
    ScoreBuf scores;
    UintBuf required;
    uint splitCount;
    float pixelBudget;
}
pc;

layout(local_size_x = 64) in;

void main()
{
    const uint s = gl_GlobalInvocationID.x;
    if (s >= pc.splitCount)
    {
        return;
    }
    const ScoreOut o = pc.scores.v[s];
    pc.required.v[s] = applyMarkRequired(o, pc.pixelBudget) ? 1u : 0u;
}
