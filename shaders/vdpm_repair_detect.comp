#version 450
#extension GL_EXT_buffer_reference : require

// VDPM GPU repair pass (Stage B4): one invocation per CANONICAL finest face. Classifies foldover ∪
// coverage against the SETTLED front (the shared ancestor pass supplied `ancestorId` per canonical
// vertex) and atomic-ORs each violation's inactive-corner removing split into `required`, plus
// `repairControl[0]` (anyMarked). The screen-space policy is the PURE shared classifier in
// vdpm_repair_classify.glsl (also used by the persistent repair kernel) — a faithful port of CPU
// detail::isFoldover + detail::classifyCoverageRepair (graphics/vdpm.cpp). This shader keeps the
// buffer access, the atomics, and the required-marking; the include is math-only. All positions are
// WORLD space; `viewProj` is jitter-free. Marking (not applying) is what lets the whole pass run in
// parallel — the caller closes + refines the marked set, then re-detects the new settled front.

#include "vdpm_repair_classify.glsl"

const uint kInvalid = 0xFFFFFFFFu; // ancestor sentinel / no-split

layout(buffer_reference, std430, buffer_reference_align = 4) buffer UintBuf
{
    uint v[];
};
layout(buffer_reference, std430, buffer_reference_align = 16) buffer PosBuf
{
    vec4 v[]; // canonical object-space position (xyz), w padding
};
layout(buffer_reference, std430, buffer_reference_align = 16) buffer Params
{
    mat4 world;
    mat4 viewProj;
    vec4 cameraPos; // xyz
    vec4 viewport;  // x = width, y = height, z = rasterBackfaceCulling (0/1), w = pad
};

layout(push_constant) uniform Push
{
    UintBuf finestFaces;
    PosBuf positions;
    UintBuf activeFlags;
    UintBuf ancestorId;
    UintBuf removingSplit;
    UintBuf required;
    UintBuf repairControl;
    Params params;
    UintBuf classification; // per face: packed {foldover, coverageKind, worstLocal} (test only)
    uint faceCount;
    uint writeClassification; // 1 = write `classification`; 0 = skip (the production path)
}
pc;

layout(local_size_x = 64) in;

vec3 worldPos(uint canonical)
{
    return (pc.params.world * vec4(pc.positions.v[canonical].xyz, 1.0)).xyz;
}

void markInactiveCorner(uint corner)
{
    if (pc.activeFlags.v[corner] != 0u)
    {
        return; // already at finest here — nothing to advance
    }
    atomicOr(pc.required.v[pc.removingSplit.v[corner]], 1u);
    atomicOr(pc.repairControl.v[0], 1u);
}

void main()
{
    const uint f = gl_GlobalInvocationID.x;
    if (f >= pc.faceCount)
    {
        return;
    }
    const uint c0 = pc.finestFaces.v[3u * f + 0u];
    const uint c1 = pc.finestFaces.v[3u * f + 1u];
    const uint c2 = pc.finestFaces.v[3u * f + 2u];
    const uint a0 = pc.ancestorId.v[c0];
    const uint a1 = pc.ancestorId.v[c1];
    const uint a2 = pc.ancestorId.v[c2];
    if (a0 == kInvalid || a1 == kInvalid || a2 == kInvalid)
    {
        return; // a corrupt ancestor walk (ancestorFailure already recorded it) — skip this face
    }

    const bool degenerate = (a0 == a1 || a1 == a2 || a0 == a2);
    const bool cull = pc.params.viewport.z != 0.0;
    const RepairClassification rc = classifyRepairFace(
        worldPos(c0), worldPos(c1), worldPos(c2), worldPos(a0), worldPos(a1), worldPos(a2),
        pc.activeFlags.v[c0] != 0u, pc.activeFlags.v[c1] != 0u, pc.activeFlags.v[c2] != 0u,
        degenerate, pc.params.viewProj, pc.params.cameraPos.xyz, pc.params.viewport.xy, cull);

    if (pc.writeClassification != 0u)
    {
        pc.classification.v[f] =
            (rc.foldover ? 1u : 0u) | (rc.coverageKind << 1u) | (rc.worstLocal << 4u);
    }

    if (rc.foldover)
    {
        markInactiveCorner(c0);
        markInactiveCorner(c1);
        markInactiveCorner(c2);
    }
    if (rc.coverageKind == kRepairCoverageAllInactive)
    {
        markInactiveCorner(c0);
        markInactiveCorner(c1);
        markInactiveCorner(c2);
    }
    else if (rc.coverageKind == kRepairCoverageWorst)
    {
        markInactiveCorner((rc.worstLocal == 0u) ? c0 : (rc.worstLocal == 1u ? c1 : c2));
    }
}
